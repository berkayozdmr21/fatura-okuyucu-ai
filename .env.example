# Bu dosya SADECE örnektir. Gerçek değerleri `.env` dosyasına yaz (git'e girmez).
# Üretimde bu değerleri ortam değişkeni / gizli anahtar yöneticisi ile ver.

# --- API ---
# Uzun ve rastgele bir değer üret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=BURAYA_UZUN_RASTGELE_BIR_DEGER_YAZ
JWT_EXPIRE_MINUTES=720
# Geliştirmede SQLite, üretimde PostgreSQL
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql+psycopg2://KULLANICI:SIFRE@localhost:5432/fatura_okuyucu
STORAGE_DIR=./storage
# Yüklenen belgelerin saklanma süresi (gün). 0 = otomatik silme yok.
RETENTION_DAYS=30
MAX_UPLOAD_MB=15
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- İsteğe bağlı: Claude (yapay zeka) ---
# Boş bırakılırsa tamamen yerel/kural tabanlı mod çalışır, veri dışarı çıkmaz.
ANTHROPIC_API_KEY=
EXTRACTION_LLM_MODEL=claude-opus-5-5
CHATBOT_LLM_MODEL=claude-opus-5-5

# --- Veritabanı (docker-compose için) ---
POSTGRES_USER=KULLANICI_ADI
POSTGRES_PASSWORD=SIFRE_BURAYA
POSTGRES_DB=fatura_okuyucu
